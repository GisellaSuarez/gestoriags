---
import { getWhatsAppUrl } from '../config/business';

const waFloatingUrl = getWhatsAppUrl(
  undefined,
  'Hola Gisella, vi tu web y quiero hacerte una consulta.'
);
---

<a
  id="wa-floating-btn"
  href={waFloatingUrl}
  target="_blank"
  rel="noopener"
  aria-label="Consultar por WhatsApp"
  data-track="wa_flotante"
  tabindex="-1"
  aria-hidden="true"
  class="wa-floating-btn is-hidden"
>
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z"></path>
    <path
      d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 .8a4.5 4.5 0 0 1-2.4-2.4l.8-1-1-2z"
      fill="currentColor"
      stroke="none"
    ></path>
  </svg>
</a>

<style>
  .wa-floating-btn {
    position: fixed;
    right: clamp(16px, 3vw, 32px);
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wa);
    color: var(--navy-900);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(2, 6, 23, 0.28);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
    text-decoration: none;
  }

  .wa-floating-btn:hover {
    background: var(--wa-hover);
    transform: scale(1.06);
  }

  .wa-floating-btn.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
  }

  .wa-floating-btn.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  function setupFloatingWa() {
    const btn = document.getElementById('wa-floating-btn');
    if (!btn) return;

    const heroCta = document.getElementById('hero-wa-cta');
    const contactSection = document.getElementById('contacto');
    const finalSection = document.getElementById('final-cta');
    const footer = document.getElementById('footer');

    const seen = {
      hero: true,
      contact: false,
      final: false,
      footer: false,
    };

    function updateVisibility() {
      // Visible si el CTA del hero ya pasó Y no estamos en las zonas de contacto/footer
      const shouldShow =
        !seen.hero && !seen.contact && !seen.final && !seen.footer;
      if (shouldShow) {
        btn?.classList.remove('is-hidden');
        btn?.classList.add('is-visible');
        btn?.setAttribute('tabindex', '0');
        btn?.setAttribute('aria-hidden', 'false');
      } else {
        btn?.classList.remove('is-visible');
        btn?.classList.add('is-hidden');
        btn?.setAttribute('tabindex', '-1');
        btn?.setAttribute('aria-hidden', 'true');
      }
    }

    if (typeof IntersectionObserver !== 'undefined') {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            if (id === 'hero-wa-cta') seen.hero = entry.isIntersecting;
            if (id === 'contacto') seen.contact = entry.isIntersecting;
            if (id === 'final-cta') seen.final = entry.isIntersecting;
            if (id === 'footer') seen.footer = entry.isIntersecting;
          });
          updateVisibility();
        },
        { threshold: 0.05 }
      );

      if (heroCta) observer.observe(heroCta);
      if (contactSection) observer.observe(contactSection);
      if (finalSection) observer.observe(finalSection);
      if (footer) observer.observe(footer);
    } else {
      // Fallback para navegadores antiguos: escuchar scroll básico
      const win = window as Window;
      win.addEventListener(
        'scroll',
        () => {
          const scrolled = win.scrollY > 400;
          if (scrolled) {
            btn?.classList.remove('is-hidden');
            btn?.classList.add('is-visible');
          } else {
            btn?.classList.remove('is-visible');
            btn?.classList.add('is-hidden');
          }
        },
        { passive: true }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingWa);
  } else {
    setupFloatingWa();
  }
</script>
