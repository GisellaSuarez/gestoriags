---
const benefits = [
  {
    num: '01',
    title: 'Ahorrás tiempo',
    desc: 'Te evitás filas, idas y vueltas al registro y consultas sueltas.',
  },
  {
    num: '02',
    title: 'Menos errores',
    desc: 'Revisamos la documentación antes de presentarla, para evitar observaciones y demoras.',
  },
  {
    num: '03',
    title: 'Claridad',
    desc: 'Sabés qué se hace, por qué y qué sigue, sin tecnicismos.',
  },
  {
    num: '04',
    title: 'Acompañamiento',
    desc: 'Una persona de referencia, también en los casos más complejos.',
  },
  {
    num: '05',
    title: 'Seguimiento',
    desc: 'Te mantengo al tanto de cada avance del trámite.',
  },
];
---

<section
  id="beneficios"
  aria-labelledby="h-beneficios"
  class="benefits-section"
>
  <div class="container benefits-container">
    <div class="benefits-intro">
      <p class="benefits-eyebrow">Por qué con una gestora</p>
      <h2 id="h-beneficios" class="benefits-title">
        Menos vueltas para vos, más cuidado en cada paso.
      </h2>
    </div>

    <ol class="benefits-list">
      {benefits.map((b) => (
        <li class="benefit-item">
          <span class="benefit-number">{b.num}</span>
          <div class="benefit-text">
            <strong class="benefit-name">{b.title}</strong>
            <span class="benefit-desc">{b.desc}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .benefits-section {
    background: var(--navy-900);
    color: var(--paper);
    padding: var(--section-y) 0;
  }

  .benefits-container {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 96px);
  }

  .benefits-intro {
    flex: 1 1 320px;
    min-width: 0;
  }

  .benefits-eyebrow {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sky);
  }

  .benefits-title {
    margin: 0;
    font-size: var(--fs-h2);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--paper);
    text-wrap: balance;
  }

  .benefits-list {
    flex: 1.3 1 420px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-top: 1px solid rgba(147, 197, 232, 0.28);
  }

  .benefit-item:last-child {
    border-bottom: 1px solid rgba(147, 197, 232, 0.28);
  }

  .benefit-number {
    font-weight: 800;
    font-size: 17px;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .benefit-text {
    display: flex;
    flex-direction: column;
  }

  .benefit-name {
    display: block;
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--paper);
  }

  .benefit-desc {
    display: block;
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--on-navy-2);
  }
</style>
