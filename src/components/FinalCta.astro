---
import { BUSINESS, getWhatsAppUrl } from '../config/business';

const waFinalUrl = getWhatsAppUrl(
  undefined,
  'Hola Gisella, quiero consultar por un trámite pendiente.'
);
---

<section id="final-cta" aria-labelledby="h-final" class="final-cta-section">
  <div class="container final-container">
    <div class="final-text-block">
      <h2 id="h-final" class="final-title">
        ¿Tenés un trámite pendiente? Empecemos por una consulta.
      </h2>
      <p class="final-slogan">
        Tu trámite, <span class="final-script">sin vueltas.</span>
      </p>
    </div>

    <div class="final-actions">
      <a
        data-route="end"
        href={waFinalUrl}
        target="_blank"
        rel="noopener"
        data-track="wa_final"
        class="btn-wa-final"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z"></path>
          <path
            d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 .8a4.5 4.5 0 0 1-2.4-2.4l.8-1-1-2z"
            fill="currentColor"
            stroke="none"
          ></path>
        </svg>
        Consultar por WhatsApp
      </a>
      <a href={`mailto:${BUSINESS.email}`} class="link-email-direct">
        o escribime a {BUSINESS.email}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background: var(--navy-900);
    color: var(--paper);
    padding: clamp(72px, 10vw, 120px) 0;
  }

  .final-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .final-text-block {
    flex: 1 1 420px;
    min-width: 0;
  }

  .final-title {
    margin: 0;
    font-size: clamp(2.1rem, 1.3rem + 3.2vw, 3.8rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .final-slogan {
    margin: 18px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-navy-2);
  }

  .final-script {
    font-family: var(--script);
    font-size: 1.7em;
    color: var(--sky);
    line-height: 0.8;
    display: inline-block;
  }

  .final-actions {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    min-width: min(100%, 300px);
  }

  .btn-wa-final {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 60px;
    padding: 0 30px;
    border-radius: var(--r-pill);
    background: var(--wa);
    color: var(--navy-900);
    font-weight: 800;
    font-size: 18px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      transform 0.1s ease;
  }

  .btn-wa-final:hover {
    background: var(--wa-hover);
    color: var(--navy-900);
  }

  .link-email-direct {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    color: var(--sky);
    font-weight: 700;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .link-email-direct:hover {
    color: var(--paper);
  }
</style>
