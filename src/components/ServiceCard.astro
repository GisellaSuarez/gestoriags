---
import type { ServiceItem } from '../data/services';
import { getWhatsAppUrl } from '../config/business';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const waUrl = getWhatsAppUrl(service.waParam);
---

{service.featured ? (
  <article class="service-card-featured">
    <span class="service-number">{service.number}</span>
    <h3 class="service-title-featured">{service.title}</h3>
    <p class="service-desc">{service.description}</p>
    {service.highlightNote && (
      <p class="service-highlight">{service.highlightNote}</p>
    )}
    <a
      href={waUrl}
      target="_blank"
      rel="noopener"
      data-track="wa_servicio"
      class="service-link"
    >
      Consultar por este trámite{' '}
      <span aria-hidden="true" class="arrow">
        →
      </span>
    </a>
  </article>
) : (
  <article class="service-item-list">
    <div class="service-list-header">
      <span class="service-number">{service.number}</span>
      <h3 class="service-title-list">{service.title}</h3>
    </div>
    <p class="service-desc-list">{service.description}</p>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener"
      data-track="wa_servicio"
      class="service-link"
    >
      Consultar por este trámite{' '}
      <span aria-hidden="true" class="arrow">
        →
      </span>
    </a>
  </article>
)}

<style>
  .service-card-featured {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .service-number {
    font-size: 14px;
    font-weight: 800;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }

  .service-title-featured {
    margin: 0;
    font-size: var(--fs-h3-lg);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--navy-900);
  }

  .service-desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .service-highlight {
    margin: 0;
    padding-left: 16px;
    border-left: 3px solid var(--gold);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 700;
    color: var(--navy-900);
  }

  .service-item-list {
    border-top: 1px solid var(--border);
    padding: 28px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .service-list-header {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .service-title-list {
    margin: 0;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--navy-900);
  }

  .service-desc-list {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .service-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap-min);
    font-weight: 800;
    font-size: 15px;
    color: var(--navy-800);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .service-link:hover {
    color: var(--blue);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .service-link:hover .arrow {
    transform: translateX(4px);
  }
</style>
