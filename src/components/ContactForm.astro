---
import { BUSINESS, getWhatsAppUrl } from '../config/business';

const waFormAltUrl = getWhatsAppUrl(
  undefined,
  'Hola Gisella, quiero consultar por un trámite.'
);
---

<section id="contacto" aria-labelledby="h-contacto" class="contact-section">
  <div class="container contact-container">
    <div class="contact-intro">
      <p class="section-eyebrow">Contacto</p>
      <h2 id="h-contacto" class="section-title">
        Dejame tu consulta.
      </h2>
      <p class="contact-desc">
        Completá el formulario y te respondo por WhatsApp o email. Si preferís,
        escribime directo.
      </p>

      <div class="contact-wa-box">
        <p class="wa-box-title">¿Es más fácil por WhatsApp?</p>
        <p class="wa-box-desc">Contame tu caso en un mensaje.</p>
        <a
          href={waFormAltUrl}
          target="_blank"
          rel="noopener"
          data-track="wa_form_alt"
          class="btn-wa-alt"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z"></path>
            <path
              d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 .8a4.5 4.5 0 0 1-2.4-2.4l.8-1-1-2z"
              fill="currentColor"
              stroke="none"
            ></path>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>

    <div class="contact-form-card">
      <form
        name="consulta-gestoria"
        method="POST"
        action="/api/contacto"
        id="contact-form"
        class="form-body"
        novalidate
      >
        <!-- Campo trampa Honeypot para protección contra spam -->
        <p class="honeypot-field" style="display:none;" aria-hidden="true">
          <label>
            No completar este campo:{' '}
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <!-- Resumen de errores accesible -->
        <div
          id="error-summary"
          class="error-summary"
          role="alert"
          tabindex="-1"
          hidden
        >
          <strong id="error-summary-title">
            Revisá los siguientes campos para poder enviar:
          </strong>
          <ul id="error-summary-list" class="error-summary-list"></ul>
        </div>

        <!-- Campo: Nombre -->
        <div class="form-group">
          <label for="f-nombre" class="form-label">
            Nombre <span class="req-tag">(obligatorio)</span>
          </label>
          <input
            id="f-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            aria-describedby="e-nombre"
            class="form-input"
          />
          <p id="e-nombre" class="error-msg" aria-live="polite" hidden>
            <span aria-hidden="true" class="error-icon">
              !
            </span>
            <span class="error-text">Escribí tu nombre.</span>
          </p>
        </div>

        <!-- Campo: Teléfono / WhatsApp -->
        <div class="form-group">
          <label for="f-tel" class="form-label">
            WhatsApp o teléfono <span class="req-tag">(obligatorio)</span>
          </label>
          <input
            id="f-tel"
            name="telefono"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            placeholder="Ej: 351 123 4567"
            required
            aria-describedby="e-tel"
            class="form-input"
          />
          <p id="e-tel" class="error-msg" aria-live="polite" hidden>
            <span aria-hidden="true" class="error-icon">
              !
            </span>
            <span class="error-text">
              Necesito un WhatsApp o teléfono para responderte.
            </span>
          </p>
        </div>

        <!-- Campo: Email (opcional) -->
        <div class="form-group">
          <label for="f-email" class="form-label">
            Email <span class="opt-tag">(opcional)</span>
          </label>
          <input
            id="f-email"
            name="email"
            type="email"
            autocomplete="email"
            aria-describedby="e-email"
            class="form-input"
          />
          <p id="e-email" class="error-msg" aria-live="polite" hidden>
            <span aria-hidden="true" class="error-icon">
              !
            </span>
            <span class="error-text">
              Revisá el formato del email (ej: nombre@gmail.com).
            </span>
          </p>
        </div>

        <!-- Campo: Tipo de trámite -->
        <div class="form-group">
          <label for="f-tramite" class="form-label">
            ¿Qué trámite necesitás? <span class="req-tag">(obligatorio)</span>
          </label>
          <select
            id="f-tramite"
            name="tramite"
            required
            aria-describedby="e-tramite"
            class="form-select"
          >
            <option value="">Elegí una opción</option>
            <option value="Transferencia">Transferencia</option>
            <option value="Informe de dominio">Informe de dominio</option>
            <option value="Verificación policial">Verificación policial</option>
            <option value="Denuncia de venta">Denuncia de venta</option>
            <option value="Cambio de radicación">Cambio de radicación</option>
            <option value="Cancelación de prenda">Cancelación de prenda</option>
            <option value="Extravío de patente">Extravío de patente</option>
            <option value="Documentación vehicular">
              Documentación vehicular
            </option>
            <option value="Otro trámite">Otro trámite</option>
            <option value="No estoy seguro/a">No estoy seguro/a</option>
          </select>
          <p id="e-tramite" class="error-msg" aria-live="polite" hidden>
            <span aria-hidden="true" class="error-icon">
              !
            </span>
            <span class="error-text">
              Elegí el trámite o “No estoy seguro/a”.
            </span>
          </p>
        </div>

        <!-- Campo: Mensaje -->
        <div class="form-group">
          <label for="f-msg" class="form-label">
            Contame tu caso <span class="opt-tag">(opcional)</span>
          </label>
          <textarea
            id="f-msg"
            name="mensaje"
            rows="4"
            aria-describedby="h-msg"
            class="form-textarea"
          ></textarea>
          <p id="h-msg" class="field-hint">
            No hace falta que incluyas DNI, patente ni documentación.
          </p>
        </div>

        <!-- Consentimiento de privacidad -->
        <div class="form-group-checkbox">
          <label class="checkbox-label">
            <input
              id="f-priv"
              name="privacidad"
              type="checkbox"
              required
              aria-describedby="e-priv"
              class="form-checkbox"
            />
            <span class="checkbox-text">
              Acepto que mis datos se usen sólo para responder esta consulta.{' '}
              <a href="/privacidad/" class="legal-link" target="_blank">
                Política de privacidad
              </a>
            </span>
          </label>
          <p id="e-priv" class="error-msg" aria-live="polite" hidden>
            <span aria-hidden="true" class="error-icon">
              !
            </span>
            <span class="error-text">
              Para enviar, aceptá el uso de tus datos.
            </span>
          </p>
        </div>

        <!-- Botón de envío -->
        <button type="submit" id="btn-submit" class="btn-submit">
          Enviar consulta
        </button>

        <p class="submit-note">Tu consulta llega a {BUSINESS.email}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    scroll-margin-top: var(--header-h);
    padding: var(--section-y) 0;
  }

  .contact-container {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 96px);
    align-items: flex-start;
  }

  .contact-intro {
    flex: 1 1 300px;
    min-width: 0;
  }

  .section-eyebrow {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .section-title {
    margin: 0;
    font-size: var(--fs-h2);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--navy-900);
    text-wrap: balance;
  }

  .contact-desc {
    margin: 20px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .contact-wa-box {
    margin-top: 28px;
    padding: 24px;
    border-radius: var(--r-sm);
    background: var(--navy-900);
    color: var(--paper);
  }

  .wa-box-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
  }

  .wa-box-desc {
    margin: 6px 0 18px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--on-navy-2);
  }

  .btn-wa-alt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    background: var(--wa);
    color: var(--navy-900);
    font-weight: 800;
    font-size: 16px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .btn-wa-alt:hover {
    background: var(--wa-hover);
    color: var(--navy-900);
  }

  .contact-form-card {
    flex: 1.4 1 420px;
    min-width: 0;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: clamp(24px, 4vw, 44px);
  }

  .form-body {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .error-summary[hidden],
  .error-msg[hidden] {
    display: none !important;
  }

  .error-summary {
    padding: 16px 18px;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--error);
    background: #fef3f2;
    color: #7a1a12;
    outline: none;
  }

  .error-summary-list {
    margin: 8px 0 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
  }

  .error-summary-list a {
    color: #7a1a12;
    font-weight: 700;
    text-decoration: underline;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--navy-900);
  }

  .req-tag {
    font-weight: 600;
    color: var(--text-2);
  }

  .opt-tag {
    font-weight: 600;
    color: var(--text-2);
  }

  .form-input,
  .form-select {
    min-height: 52px;
    padding: 0 16px;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--text-2);
    background: #ffffff;
    color: var(--ink);
    font-size: 17px;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .form-textarea {
    padding: 14px 16px;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--text-2);
    background: #ffffff;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.5;
    resize: vertical;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px var(--sky);
  }

  .form-input.is-invalid,
  .form-select.is-invalid {
    border-color: var(--error) !important;
  }

  .error-msg {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--error);
  }

  .error-icon {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--error);
    color: #ffffff;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .field-hint {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }

  .form-group-checkbox {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .checkbox-label {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    cursor: pointer;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    min-height: var(--tap-min);
  }

  .form-checkbox {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 2px 0 0;
    accent-color: var(--navy-800);
    cursor: pointer;
  }

  .legal-link {
    font-weight: 700;
    color: var(--blue);
  }

  .btn-submit {
    min-height: 56px;
    padding: 0 28px;
    border-radius: var(--r-pill);
    border: none;
    background: var(--navy-800);
    color: var(--paper);
    font-weight: 800;
    font-size: 17px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      opacity 0.15s ease;
  }

  .btn-submit:hover:not(:disabled) {
    background: var(--navy-900);
  }

  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-note {
    margin: -6px 0 0;
    font-size: 14px;
    color: var(--text-2);
    text-align: center;
  }
</style>

<script>
  function setupForm() {
    const form = document.getElementById(
      'contact-form'
    ) as HTMLFormElement | null;
    if (!form) return;

    const summary = document.getElementById('error-summary');
    const summaryList = document.getElementById('error-summary-list');
    const submitBtn = document.getElementById(
      'btn-submit'
    ) as HTMLButtonElement | null;

    const fields = {
      nombre: form.querySelector('#f-nombre') as HTMLInputElement,
      tel: form.querySelector('#f-tel') as HTMLInputElement,
      email: form.querySelector('#f-email') as HTMLInputElement,
      tramite: form.querySelector('#f-tramite') as HTMLSelectElement,
      priv: form.querySelector('#f-priv') as HTMLInputElement,
    };

    const errors = {
      nombre: form.querySelector('#e-nombre') as HTMLElement,
      tel: form.querySelector('#e-tel') as HTMLElement,
      email: form.querySelector('#e-email') as HTMLElement,
      tramite: form.querySelector('#e-tramite') as HTMLElement,
      priv: form.querySelector('#e-priv') as HTMLElement,
    };

    function validate() {
      const errs: Record<string, string> = {};

      if (!fields.nombre.value.trim()) {
        errs.nombre = 'Escribí tu nombre.';
      }

      const digits = fields.tel.value.replace(/\D/g, '');
      if (!digits) {
        errs.tel = 'Necesito un WhatsApp o teléfono para responderte.';
      } else if (digits.length < 8) {
        errs.tel = 'El número parece incompleto. Incluí la característica.';
      }

      const emailVal = fields.email.value.trim();
      if (emailVal && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        errs.email = 'Revisá el formato del email (ej: nombre@gmail.com).';
      }

      if (!fields.tramite.value) {
        errs.tramite = 'Elegí el trámite o “No estoy seguro/a”.';
      }

      if (!fields.priv.checked) {
        errs.priv = 'Para enviar, aceptá el uso de tus datos.';
      }

      return errs;
    }

    function updateUi(errs: Record<string, string>, showAll = false) {
      const keys = ['nombre', 'tel', 'email', 'tramite', 'priv'] as const;
      let count = 0;
      const isSummaryVisible = !!(summary && !summary.hasAttribute('hidden'));
      const shouldPopulateSummary = showAll || isSummaryVisible;

      if (summaryList) summaryList.innerHTML = '';

      keys.forEach((key) => {
        const field = fields[key];
        const errorEl = errors[key];
        const hasError = !!errs[key];

        if (showAll || field.dataset.touched === 'true') {
          if (hasError) {
            field.classList.add('is-invalid');
            field.setAttribute('aria-invalid', 'true');
            if (errorEl) {
              errorEl.removeAttribute('hidden');
              const textSpan = errorEl.querySelector('.error-text');
              if (textSpan) textSpan.textContent = errs[key];
            }
          } else {
            field.classList.remove('is-invalid');
            field.setAttribute('aria-invalid', 'false');
            if (errorEl) errorEl.setAttribute('hidden', '');
          }
        }

        if (hasError) {
          count++;
          if (shouldPopulateSummary && summaryList) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#f-${key}`;
            a.textContent = errs[key];
            a.addEventListener('click', (e) => {
              e.preventDefault();
              field.focus();
            });
            li.appendChild(a);
            summaryList.appendChild(li);
          }
        }
      });

      if (summary) {
        if (showAll && count > 0) {
          summary.removeAttribute('hidden');
          summary.focus();
        } else if (isSummaryVisible && count > 0) {
          summary.removeAttribute('hidden');
        } else if (count === 0) {
          summary.setAttribute('hidden', '');
        }
      }
    }

    // Validación interactiva on blur
    Object.values(fields).forEach((element) => {
      element.addEventListener('blur', () => {
        element.dataset.touched = 'true';
        updateUi(validate(), false);
      });
      element.addEventListener('input', () => {
        if (element.dataset.touched === 'true') {
          updateUi(validate(), false);
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errs = validate();
      if (Object.keys(errs).length > 0) {
        updateUi(errs, true);
        return;
      }

      const botField = form.querySelector(
        '[name="bot-field"]'
      ) as HTMLInputElement | null;
      const msgField = form.querySelector(
        '#f-msg'
      ) as HTMLTextAreaElement | null;

      const payload = {
        nombre: fields.nombre.value.trim(),
        telefono: fields.tel.value.trim(),
        email: fields.email.value.trim(),
        tramite: fields.tramite.value,
        mensaje: msgField ? msgField.value.trim() : '',
        privacidad: fields.priv.checked,
        'bot-field': botField ? botField.value : '',
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = 'Enviando consulta…';
      }

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          window.location.href = '/gracias/';
          return;
        }

        const data = await res.json().catch(() => null);
        const serverError =
          data?.error ||
          'Hubo un problema al enviar tu consulta. Por favor escribinos directamente por WhatsApp.';

        if (summary && summaryList) {
          summaryList.innerHTML = '';
          const li = document.createElement('li');
          li.textContent = serverError;
          summaryList.appendChild(li);
          summary.removeAttribute('hidden');
          summary.focus();
        }
      } catch {
        if (summary && summaryList) {
          summaryList.innerHTML = '';
          const li = document.createElement('li');
          li.textContent =
            'No se pudo conectar con el servidor. Revisá tu conexión o escribinos por WhatsApp.';
          summaryList.appendChild(li);
          summary.removeAttribute('hidden');
          summary.focus();
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          submitBtn.textContent = 'Enviar consulta';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupForm);
  } else {
    setupForm();
  }
</script>
