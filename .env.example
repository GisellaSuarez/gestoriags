# ==========================================
# GESTORÍA GS - Variables de Entorno
# ==========================================
# Copiar este archivo a .env para desarrollo local o
# configurar estas variables en el panel de Netlify:
# Site configuration > Environment variables
# ==========================================

# ------------------------------------------
# SERVICIO DE ENVÍO DE CORREOS (RESEND)
# ------------------------------------------
# Clave de API de Resend (Crear en https://resend.com/api-keys)
# OBLIGATORIA para que el formulario envíe emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los correos enviados (From)
# Mientras el dominio no esté verificado en Resend, podés usar: Gestoría GS <onboarding@resend.dev>
# Una vez verificado tu dominio en Resend, usá: Gestoría GS <consultas@gestoriags.com.ar>
RESEND_FROM_EMAIL=Gestoría GS <onboarding@resend.dev>

# Destinatario donde Gisella recibe las consultas
CONTACT_RECIPIENT_EMAIL=info.gestoriags@gmail.com

# ------------------------------------------
# CONFIGURACIÓN PÚBLICA DEL SITIO
# ------------------------------------------
# URL canónica del sitio (utilizada para sitemaps, Open Graph y canonical URLs)
PUBLIC_SITE_URL=https://gestoriags.com.ar

# Datos de contacto comercial (visibles en la web)
PUBLIC_CONTACT_EMAIL=info.gestoriags@gmail.com
PUBLIC_PHONE_DISPLAY=+54 9 351 375-0475
PUBLIC_PHONE_RAW=5493513750475

# Redes sociales
PUBLIC_INSTAGRAM_HANDLE=@gestoria.gs
PUBLIC_INSTAGRAM_URL=https://instagram.com/gestoria.gs
