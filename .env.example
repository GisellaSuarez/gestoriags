# ==========================================
# GESTORÍA GS - Variables de Entorno (Plantilla)
# ==========================================
# Copiar este archivo a .env para desarrollo local o
# configurar estas variables en el panel de Netlify:
# Site configuration > Environment variables
# ==========================================

# ------------------------------------------
# SERVICIO DE ENVÍO DE CORREOS (RESEND)
# ------------------------------------------
# Clave de API de Resend (Crear en https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los correos enviados (From)
# Inicial / Pruebas: Gestoría GS <onboarding@resend.dev>
# Con dominio verificado: Gestoría GS <remitente@tudominio.com>
RESEND_FROM_EMAIL=Gestoría GS <onboarding@resend.dev>

# Destinatario donde se reciben las consultas
CONTACT_RECIPIENT_EMAIL=tu-email@dominio.com

# ------------------------------------------
# CONFIGURACIÓN PÚBLICA DEL SITIO
# ------------------------------------------
PUBLIC_SITE_URL=https://gestoriags.com.ar
PUBLIC_CONTACT_EMAIL=contacto@gestoriags.com.ar
PUBLIC_PHONE_DISPLAY=+54 9 351 000-0000
PUBLIC_PHONE_RAW=5493510000000
PUBLIC_INSTAGRAM_HANDLE=@gestoria.gs
PUBLIC_INSTAGRAM_URL=https://instagram.com/gestoria.gs
